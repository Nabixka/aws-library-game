{
  "Comment": "Route successful library-game authentication events.",
  "StartAt": "RouteAuthAction",
  "States": {
    "RouteAuthAction": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.action",
          "StringEquals": "register",
          "Next": "RegistrationAccepted"
        },
        {
          "Variable": "$.action",
          "StringEquals": "login",
          "Next": "LoginAccepted"
        }
      ],
      "Default": "UnsupportedAction"
    },
    "RegistrationAccepted": {
      "Type": "Succeed",
      "Comment": "Registration was completed by the register Lambda before this execution started."
    },
    "LoginAccepted": {
      "Type": "Succeed",
      "Comment": "Login was completed by the login Lambda before this execution started."
    },
    "UnsupportedAction": {
      "Type": "Fail",
      "Error": "UnsupportedAuthAction",
      "Cause": "The action must be either register or login."
    }
  }
}
